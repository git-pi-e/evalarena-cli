# EvalArena CLI (Go) configuration example

# API
EVALARENA_BASE_URL=https://evalarena-backend-89846023945.us-central1.run.app
EVALARENA_TIMEOUT_S=15

# Auth (set by evalarena auth login)
# EVALARENA_TOKEN=

# Output
EVALARENA_OUTPUT_FORMAT=table
EVALARENA_NO_COLOR=false
EVALARENA_DEFAULT_COLUMNS=name,creator,mmlu,mmlu_pro,humaneval,active_params_in_billion,input_price_per_1M_tokens_USD

# Cache
EVALARENA_CACHE_ENABLED=true
EVALARENA_CACHE_TTL_SECONDS=3600

# Charts
EVALARENA_CHART_WIDTH=100
EVALARENA_CHART_HEIGHT=30
EVALARENA_CHART_NORMALIZE=none

# Chat defaults
EVALARENA_CHAT_DEFAULT_MODELS=


